# ============================================================
# 环境配置模板：复制为本目录 .env 后填写真实值（.env 严禁提交 git）
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
# ============================================================

# ---- DeepSeek API（LLM 底座）----
# 从 https://platform.deepseek.com 获取
THESIS_DEEPSEEK_API_KEY=sk-你的DeepSeek密钥
THESIS_DEEPSEEK_BASE_URL=https://api.deepseek.com
THESIS_DEEPSEEK_MODEL=deepseek-v4-flash
# LLM 不可用时是否自动回退确定性 Mock（正式使用必须为 false；仅离线演示/测试开启）
THESIS_DEEPSEEK_FALLBACK_TO_MOCK=false
# 是否启用 LLM（false=全部走 Mock，离线演示/测试用）
THESIS_DEEPSEEK_ENABLED=true

# ---- 数据库 ----
# 本地开发：SQLite 过渡（零依赖）；生产迁 PostgreSQL 改这一行
THESIS_DB_URL=sqlite:///./thesis.db

# ---- 任务/会话 ----
# 任务列表+各环产物的 SQLite 持久化路径（默认 backend/task_store.db，gitignored）
# THESIS_TASK_STORE_DIR=./storage
# 设为 true 则任务改内存存储（重启丢失），仅测试用
# THESIS_TASK_STORE_MEMORY=false
# 可分别覆盖版本化产物、证据账本和实验结果血缘数据库路径
# THESIS_ARTIFACT_DB=./artifacts.db
# THESIS_EVIDENCE_DB=./evidence.db
# THESIS_RESEARCH_DB=./research.db
# THESIS_SECTION_DB=./sections.db
# THESIS_JOB_DB=./jobs.db

# ---- 后台作业与预算 ----
# 是否随 API 进程启动持久化 Worker（测试或独立 Worker 部署可关闭）
THESIS_JOB_WORKER_ENABLED=true
# 费用预算不硬编码供应商价格；配置当前模型每百万 Token 价格后才允许 cost_budget
THESIS_LLM_INPUT_COST_PER_MILLION=0
THESIS_LLM_OUTPUT_COST_PER_MILLION=0

# ---- 文献检索 ----
# 文献检索总开关（false 时环3/环8 关闭真实检索）
THESIS_LIT_ENABLED=true
# 检索范围默认值：english / chinese / all
THESIS_LIT_SCOPE=all
# 秘塔 AI 搜索 API（中文检索源，付费 0.03元/次；默认关闭省钱）
THESIS_METASO_API_KEY=
THESIS_METASO_ENABLED=false

# ---- CORS ----
# 允许的前端来源，逗号分隔；默认 *（本地开发放开，生产务必收紧）
# THESIS_CORS_ORIGINS=http://localhost:8787

# ---- 知识库 ----
# 会话知识库根目录（默认 backend/storage/kb）
# THESIS_KB_ROOT=./storage/kb

# ---- RAG（本地语义检索，零成本）----
# 嵌入模型首次运行自动下载（BAAI/bge-small-zh-v1.5，约100MB，需可访问 HF/镜像）
# THESIS_RAG_ENABLED=true
